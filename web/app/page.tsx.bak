"use client";

import { useEffect, useState, Suspense } from "react";
import { motion } from "framer-motion";
import { api } from "../lib/api";
import { useAuth } from "../context/AuthContext";
import { useRouter } from "next/navigation";

export default function Home() {
  const { user } = useAuth();
  const [movies, setMovies] = useState<any[]>([]);
  const router = useRouter();

  // Load movies
  useEffect(() => {
    api.movies().then(setMovies).catch(console.error);
  }, []);

  const handleBuy = (movieTitle: string) => {
    if (!user) {
      router.push("/register");
      return;
    }
    router.push(`/buy?movie=${encodeURIComponent(movieTitle)}`);
  };

  return (
    <main className="py-6">
      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {movies.map((movie, i) => (
          <motion.div
            key={i}
            initial={{ opacity: 0, y: 20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ delay: i * 0.1 }}
            className="card hover:border-blue-500/50 transition-colors"
          >
            <div className="aspect-video bg-gray-800 rounded-lg mb-4 flex items-center justify-center">
              Cover Placeholder
            </div>
            <h3 className="text-xl font-bold mb-2">{movie.title}</h3>
            <div className="flex gap-2 mb-4">
              {movie.sessions.map((s: string) => (
                <span key={s} className="px-2 py-1 bg-white/10 rounded text-sm">{s}</span>
              ))}
            </div>
            <button onClick={() => handleBuy(movie.title)} className="btn w-full">
              Buy Ticket / 500 RUB
            </button>
          </motion.div>
        ))}
      </div>
    </main>
  );
}
